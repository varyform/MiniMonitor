#!/usr/bin/env bash
# Releases a version: dates the changelog's Unreleased section, sets the
# version in Info.plist, runs CI, builds a Developer ID copy and has Apple
# notarize it, then commits, tags vVERSION, pushes and publishes a GitHub
# release with the stapled app, zipped. Nothing is committed or pushed until
# notarization has passed.
# Usage: bin/release 0.2
# Once:  xcrun notarytool store-credentials <profile> --apple-id <Apple ID> --team-id <team>
#        Any profile of the team works (NOTARY_PROFILE, default hive-notary).
set -euo pipefail
cd "$(dirname "$0")/.."

version=${1:?usage: bin/release <version>}
tag="v$version"
profile=${NOTARY_PROFILE:-hive-notary}

[ "$(git branch --show-current)" = main ] || { echo "Release from main" >&2; exit 1; }
[ -z "$(git status --porcelain)" ] || { echo "Working tree is not clean" >&2; exit 1; }
! git rev-parse -q --verify "refs/tags/$tag" >/dev/null || { echo "$tag already exists" >&2; exit 1; }
security find-identity -v -p codesigning | grep -q '"Developer ID Application: ' \
  || { echo "No Developer ID Application certificate in the keychain" >&2; exit 1; }
xcrun notarytool history --keychain-profile "$profile" >/dev/null 2>&1 \
  || { echo "No notarytool profile '$profile' (see the top of this script)" >&2; exit 1; }

# The release notes are the Unreleased section's bullets.
notes=$(awk '/^## Unreleased/ { on = 1; next } /^## / { on = 0 } on' CHANGELOG.md | sed '/./,$!d')
[ -n "$notes" ] || { echo "CHANGELOG.md has nothing under Unreleased" >&2; exit 1; }

today=$(date +%Y-%m-%d)
sed -i '' "s/^## Unreleased$/## Unreleased\\
\\
## $version — $today/" CHANGELOG.md
plutil -replace CFBundleShortVersionString -string "$version" Info.plist
# Build number: commits on main, so it only grows (+1 for the release commit).
plutil -replace CFBundleVersion -string "$(($(git rev-list --count HEAD) + 1))" Info.plist

undo() { git checkout -- CHANGELOG.md Info.plist; }
trap undo ERR
bin/ci

# The timestamped build Apple notarizes; stapled so it opens offline too.
SIGN_TIMESTAMP=1 bin/build
zip="build/MiniMonitor-$version.zip"
rm -f "$zip"
ditto -c -k --keepParent build/MiniMonitor.app "$zip"
xcrun notarytool submit "$zip" --keychain-profile "$profile" --wait --output-format plist \
  >build/notary.plist || true
if [ "$(/usr/libexec/PlistBuddy -c 'Print :status' build/notary.plist 2>/dev/null)" != Accepted ]; then
  id=$(/usr/libexec/PlistBuddy -c 'Print :id' build/notary.plist 2>/dev/null || true)
  [ -n "$id" ] && xcrun notarytool log "$id" --keychain-profile "$profile" >&2
  echo "Notarization failed" >&2
  false
fi
xcrun stapler staple -q build/MiniMonitor.app
spctl --assess --type execute build/MiniMonitor.app
rm -f "$zip"
ditto -c -k --keepParent build/MiniMonitor.app "$zip"
trap - ERR

git add CHANGELOG.md Info.plist
git commit -q -m "Release $version"
git tag -a "$tag" -m "MiniMonitor $version"
git push -q origin main "$tag"

gh release create "$tag" "$zip" --title "MiniMonitor $version" --notes "$notes"
echo "Released $tag"
